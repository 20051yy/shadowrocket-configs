#!name=G1 ACQ TRY
#!desc=土耳其标准价版：2TB annual / AI Ultra monthly，不用获客折扣 SKU
#!system=ios

[Rule]
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq-try = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/20051yy/shadowrocket-configs/main/g1-acq-try.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.4.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
